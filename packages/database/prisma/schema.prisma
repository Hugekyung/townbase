generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DataSourceType {
  notion
  local_repo
}

enum SourceType {
  notion_page
  repo_readme
  repo_docs
  adr
  prd
  schema
  migration
  issue_template
  pr_template
  incident_review
  github_issue
  github_pr
  slack_thread
  uploaded_file
}

enum KnowledgeType {
  onboarding
  product_history
  architecture
  domain_policy
  database
  deployment
  incident
  code_convention
  testing
  operation
  documentation_gap
  unknown
}

enum DocumentStatus {
  active
  draft
  deprecated
  archived
}

enum RetrievalMode {
  auto
  onboarding
  product_history
  documentation_gap
  change_impact
}

enum GapPriority {
  low
  medium
  high
}

enum GapStatus {
  open
  drafted
  resolved
  ignored
}

enum ActionDraftType {
  github_issue
  markdown_doc
  notion_page
}

enum ActionDraftStatus {
  draft
  copied
  discarded
}

enum AuditActorType {
  server
  administrator
}

enum InstallationAuditAction {
  installation_created
  installation_settings_changed
  administrator_created
  bootstrap_token_issued
  bootstrap_token_consumed
  bootstrap_token_rejected
  administrator_logged_in
  administrator_login_rejected
  administrator_logged_out
  administrator_password_changed
  recovery_token_issued
  recovery_token_rejected
  recovery_token_consumed
  answer_key_updated
  answer_key_disabled
  answer_key_deleted
  embedding_key_updated
  embedding_key_disabled
  embedding_key_deleted
  model_transfer_policy_changed
  model_execution_settings_changed
}

// Seeded singleton, even before the operator explicitly links the installation.
// Raw tokens belong only in the protected server-local file.
model BootstrapState {
  id                   String    @id @default("primary")
  tokenHash            String?   @db.VarChar(64)
  issuedAt             DateTime?
  expiresAt            DateTime?
  consumedAt           DateTime?
  failedAttempts       Int       @default(0)
  attemptWindowStart   DateTime?
  blockedUntil         DateTime?
}

enum AuditOutcome {
  succeeded
  failed
}

// SQL CHECK restricts this table to the single "primary" installation.
// Existing workspaces are linked explicitly at setup, never during migration.
model Installation {
  id                  String                   @id @default("primary")
  workspaceId         String                   @unique
  name                String                   @db.VarChar(128)
  timeZone            String                   @db.VarChar(64)
  initializedAt       DateTime?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  workspace           Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  administrator       Administrator?
  auditEvents         InstallationAuditEvent[]
  modelCredentials    ModelCredential[]
  modelTransferPolicy ModelTransferPolicy?
  modelExecutionSettings ModelExecutionSettings?
  modelCalls ModelCall[]
  fileOriginals FileOriginal[]
  fileVersions FileVersion[]
  fileExtractionRuns FileExtractionRun[]
}

model Administrator {
  id                  String                   @id @default(cuid())
  installationId      String                   @unique
  username            String                   @db.VarChar(128)
  passwordHash        String                   @db.VarChar(512)
  disabledAt          DateTime?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  installation        Installation             @relation(fields: [installationId], references: [id], onDelete: Restrict)
  auditEvents         InstallationAuditEvent[]

  sessions            AdministratorSession[]
  fileOriginals       FileOriginal[]

  @@unique([installationId, id])
}

// One authentication lane per installation, present before initial setup.
model AuthenticationState {
  id                   String    @id @default("primary")
  loginFailures        Int       @default(0)
  loginWindowStart     DateTime?
  loginBlockedUntil    DateTime?
  recoveryHash         String?   @db.VarChar(64)
  recoveryIssuedAt     DateTime?
  recoveryExpiresAt    DateTime?
  recoveryConsumedAt   DateTime?
  recoveryFailures     Int       @default(0)
  recoveryWindowStart  DateTime?
  recoveryBlockedUntil DateTime?
}

model AdministratorSession {
  tokenHash       String        @id @db.VarChar(64)
  installationId  String
  administratorId String
  createdAt       DateTime      @default(now())
  expiresAt       DateTime
  lastSeenAt      DateTime
  revokedAt       DateTime?
  administrator   Administrator @relation(fields: [installationId, administratorId], references: [installationId, id], onDelete: Restrict)

  @@index([installationId, revokedAt], map: "AdministratorSession_installation_revoked_idx")
}

// No free-form payload: passwords, API keys, questions and file bodies do not
// belong in the audit trail. Extend typed actions alongside their feature.
model InstallationAuditEvent {
  id                    String                  @id @default(cuid())
  installationId        String
  actorType             AuditActorType
  actorAdministratorId  String?
  action                InstallationAuditAction
  outcome               AuditOutcome
  requestId             String                  @db.VarChar(128)
  occurredAt            DateTime                @default(now())
  installation          Installation            @relation(fields: [installationId], references: [id], onDelete: Restrict)
  actorAdministrator    Administrator?          @relation(fields: [installationId, actorAdministratorId], references: [installationId, id], onDelete: Restrict)

  @@index([installationId, occurredAt])
  @@index([installationId, requestId])
}

model Workspace {
  id              String           @id @default(cuid())
  name            String           @unique
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  dataSources     DataSource[]
  documents       Document[]
  documentChunks  DocumentChunk[]
  questions       Question[]
  questionSources QuestionSource[]
  knowledgeGaps   KnowledgeGap[]
  actionDrafts    ActionDraft[]
  installation    Installation?
}

model DataSource {
  id           String         @id @default(cuid())
  workspaceId  String
  type         DataSourceType
  name         String
  rootPath     String?
  rootPageId   String?
  config       Json?
  lastSyncedAt DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  workspace    Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  documents    Document[]

  @@unique([workspaceId, name])
  @@unique([workspaceId, id])
  @@index([workspaceId, type])
  @@index([workspaceId])
}

model Document {
  id                String          @id @default(cuid())
  workspaceId       String
  dataSourceId      String
  externalId        String
  sourceType        SourceType
  title             String
  url               String?
  filePath          String?
  repoName          String?
  content           String
  contentHash       String?
  status            DocumentStatus  @default(active)
  indexStatus       String          @default("pending")
  knowledgeTypes    KnowledgeType[]
  domainTags        String[]
  externalCreatedAt DateTime?
  externalUpdatedAt DateTime?
  metadata          Json?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  workspace         Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  dataSource        DataSource      @relation(fields: [workspaceId, dataSourceId], references: [workspaceId, id], onDelete: Cascade)
  chunks            DocumentChunk[]

  @@unique([dataSourceId, externalId])
  @@unique([workspaceId, id])
  @@index([workspaceId, sourceType])
  @@index([workspaceId, status])
  @@index([workspaceId])
  @@index([dataSourceId])
}

model DocumentChunk {
  id              String           @id @default(cuid())
  workspaceId     String
  documentId      String
  content         String
  embedding       Unsupported("vector")?
  embeddingModel  String?
  sourceType      SourceType
  chunkType       String
  chunkIndex      Int
  sectionTitle    String?
  headingPath     Json
  contentHash     String
  knowledgeTypes  KnowledgeType[]
  domainTags      String[]
  sourcePriority  Int
  tokenCount      Int?
  metadata        Json?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  workspace       Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  document        Document         @relation(fields: [workspaceId, documentId], references: [workspaceId, id], onDelete: Cascade)
  questionSources QuestionSource[]

  @@unique([workspaceId, id])
  @@unique([workspaceId, documentId, chunkIndex])
  @@index([workspaceId, documentId])
  @@index([workspaceId])
  @@index([documentId])
}

model Question {
  id              String           @id @default(cuid())
  workspaceId     String
  question        String
  answer          String?
  requestedMode   RetrievalMode    @default(auto)
  resolvedMode    RetrievalMode?
  confidence      Float?
  isAnswerable    Boolean          @default(false)
  createdAt       DateTime         @default(now())
  workspace       Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  questionSources QuestionSource[]
  knowledgeGap    KnowledgeGap?

  @@unique([workspaceId, id])
  @@index([workspaceId, requestedMode])
  @@index([workspaceId])
}

model QuestionSource {
  id          String        @id @default(cuid())
  workspaceId String
  questionId  String
  chunkId     String
  score       Float
  rank        Int
  mode        RetrievalMode
  createdAt   DateTime      @default(now())
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  question    Question      @relation(fields: [workspaceId, questionId], references: [workspaceId, id], onDelete: Cascade)
  chunk       DocumentChunk @relation(fields: [workspaceId, chunkId], references: [workspaceId, id], onDelete: Cascade)

  @@unique([workspaceId, questionId, chunkId, mode])
  @@index([workspaceId])
  @@index([questionId, mode])
  @@index([chunkId])
}

model KnowledgeGap {
  id                        String        @id @default(cuid())
  workspaceId               String
  questionId                String        @unique
  category                  String
  title                     String
  description               String?
  suggestedDocumentTitle    String
  suggestedMarkdownPath     String
  suggestedGithubIssueTitle String
  priority                  GapPriority   @default(medium)
  status                    GapStatus     @default(open)
  similarQuestionCount      Int           @default(0)
  relatedMode               RetrievalMode
  createdAt                 DateTime      @default(now())
  updatedAt                 DateTime      @updatedAt
  workspace                 Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  question                  Question      @relation(fields: [workspaceId, questionId], references: [workspaceId, id], onDelete: Cascade)
  actionDrafts              ActionDraft[]

  @@unique([workspaceId, questionId])
  @@unique([workspaceId, id])
  @@index([workspaceId, category])
  @@index([workspaceId, relatedMode, status])
  @@index([workspaceId])
  @@index([questionId])
}

model ActionDraft {
  id             String            @id @default(cuid())
  workspaceId    String
  knowledgeGapId String
  type           ActionDraftType
  title          String
  body           String
  status         ActionDraftStatus @default(draft)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  workspace      Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  knowledgeGap   KnowledgeGap      @relation(fields: [workspaceId, knowledgeGapId], references: [workspaceId, id], onDelete: Cascade)

  @@index([workspaceId])
  @@unique([workspaceId, knowledgeGapId, type])
  @@index([knowledgeGapId])
}


enum ModelCredentialPurpose {
  answer
  embedding
}

// Only the current encrypted credential is stored, never a plaintext key/history.
model ModelCredential {
  installationId String
  purpose        ModelCredentialPurpose
  enabled        Boolean @default(true)
  formatVersion  Int
  keyId          String @db.VarChar(64)
  nonce          String @db.VarChar(16)
  ciphertext     String @db.VarChar(1024)
  tag            String @db.VarChar(22)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  installation   Installation @relation(fields: [installationId], references: [id], onDelete: Restrict)

  @@id([installationId, purpose])
}

model ModelTransferPolicy {
  installationId    String @id
  documentEmbedding Boolean @default(false)
  rag               Boolean @default(false)
  attachment        Boolean @default(false)
  updatedAt         DateTime @updatedAt
  installation      Installation @relation(fields: [installationId], references: [id], onDelete: Restrict)
}

// Current installation settings only; no future provider/plugin tables.
model ModelExecutionSettings {
  installationId       String       @id
  answerModel          String       @default("gpt-6-luna") @db.VarChar(64)
  reasoning            String       @default("low") @db.VarChar(16)
  inputTokenLimit      Int          @default(16000)
  outputTokenLimit     Int          @default(4096)
  monthlyBudgetNanoUsd BigInt?
  priceVersion         String?      @db.VarChar(64)
  updatedAt            DateTime     @updatedAt
  installation         Installation @relation(fields: [installationId], references: [id], onDelete: Restrict)
}

// No prompt, attachment, answer, raw credential or raw provider errors here.
// Unknown charge reservations survive restarts, month rollover and Key changes.
model ModelCall {
  installationId       String
  requestId            String       @db.Uuid
  ownerAdministratorId String
  purpose              String       @db.VarChar(32)
  model                String       @db.VarChar(64)
  credentialTag        String       @db.VarChar(22)
  inputDigest          String       @db.VarChar(64)
  configurationDigest  String       @db.VarChar(64)
  priceVersion         String       @db.VarChar(64)
  reservedNanoUsd      BigInt
  chargedNanoUsd       BigInt?
  status               String       @db.VarChar(16)
  errorCode            String?      @db.VarChar(64)
  usage                Json?
  providerId           String?      @db.VarChar(200)
  createdAt            DateTime     @default(now())
  deadlineAt           DateTime
  completedAt          DateTime?
  installation         Installation @relation(fields: [installationId], references: [id], onDelete: Restrict)

  @@id([installationId, requestId])
  @@index([installationId, createdAt])
}

// D01 persistence foundation. No public upload/indexing endpoint until D02/D03.
model FileOriginal {
  id                   String @id @db.Uuid
  installationId       String
  ownerAdministratorId String
  title                String @db.VarChar(255)
  createdAt            DateTime @default(now())
  installation         Installation @relation(fields: [installationId], references: [id], onDelete: Restrict)
  owner                Administrator @relation(fields: [installationId, ownerAdministratorId], references: [installationId, id], onDelete: Restrict)
  versions             FileVersion[]

  @@unique([installationId, id])
}

model FileVersion {
  id             String @id @db.Uuid
  installationId String
  originalId     String @db.Uuid
  version        Int
  fileName       String @db.VarChar(255)
  format         String @db.VarChar(8)
  byteSize       Int
  contentHash    String @db.VarChar(64)
  storageKey     String @unique @db.VarChar(80)
  sourceType     SourceType @default(uploaded_file)
  knowledgeTypes KnowledgeType[]
  domainTags     String[]
  documentStatus DocumentStatus @default(active)
  extraction     Json?
  createdAt      DateTime @default(now())
  installation   Installation @relation(fields: [installationId], references: [id], onDelete: Restrict)
  original       FileOriginal @relation(fields: [installationId, originalId], references: [installationId, id], onDelete: Restrict)
  runs           FileExtractionRun[]

  @@unique([installationId, id])
  @@unique([installationId, originalId, version])
}

model FileExtractionRun {
  id             String @id @db.Uuid
  installationId String
  versionId      String @db.Uuid
  status         String @db.VarChar(16)
  errorCode      String? @db.VarChar(64)
  startedAt      DateTime
  completedAt    DateTime
  installation   Installation @relation(fields: [installationId], references: [id], onDelete: Restrict)
  fileVersion    FileVersion @relation(fields: [installationId, versionId], references: [installationId, id], onDelete: Restrict)

  @@index([installationId, completedAt])
}
