{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/check-json.mjs\"",
            "onFailure": "block",
            "timeout": 10,
            "statusMessage": "Checking JSON syntax"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/commit-check.mjs\"",
            "onFailure": "block",
            "timeout": 30,
            "statusMessage": "Checking whitespace before git commit"
          }
        ]
      }
    ]
  }
}
